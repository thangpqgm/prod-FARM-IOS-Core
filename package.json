{
  "name": "phone-farm-nurture",
  "version": "0.1.0-review.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "iOS phone farm that nurtures TikTok accounts by niche (keyword/hashtag search + engagement), with optional video posting",
  "type": "module",
  "scripts": {
    "setup": "npm install && node scripts/setup.mjs",
    "prestart": "npm run build:web",
    "start": "node --env-file-if-exists=.env --import tsx src/start.ts",
    "nurture": "node --env-file-if-exists=.env --import tsx src/tiktok/nurture.ts",
    "post": "node --env-file-if-exists=.env --import tsx src/tiktok/post.ts",
    "wda:prepare": "node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/devices/wda/prepare.ts",
    "db:generate": "drizzle-kit generate",
    "build:web": "tsc -p tsconfig.web.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "appium-ios-device": "^3.1.21",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "htmx.org": "^2.0.8",
    "node-native-ocr": "^0.4.18",
    "sharp": "^0.35.3",
    "webdriverio": "9.31.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "appium": "^2.19.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "node-native-ocr@0.4.18": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "appium": false,
    "core-js": false,
    "edgedriver": false,
    "geckodriver": false,
    "fsevents": false,
    "better-sqlite3@12.11.1": true
  }
}
