WEB_HOST=127.0.0.1
WEB_PORT=2610
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4725
# SQLite file holding accounts, niches and session history.
FARM_DB_PATH=farm.db
# Process logs and per-session logs.
FARM_LOG_DIR=logs
# Days of per-video rows and session logs/screenshots to keep (0 = keep forever).
FARM_RETENTION_DAYS=30
# How long after a daily start time a missed slot (phone busy/offline) may still run.
NURTURE_RUN_WINDOW_MINUTES=120
TIKTOK_BUNDLE_ID=com.zhiliaoapp.musically
DEVICES_CONFIG_PATH=devices.json
# Device unlock passcodes live in devices.json ("passcode" per entry), which is
# git-ignored and written 0600 — not in this file.
WDA_LOCAL_PORT=8100
MJPEG_LOCAL_PORT=9100

# Optional. `wda:prepare` targets the sole registered (devices.json) or
# connected device, or takes `--udid <udid>`. Set this only to pin one device
# for the CLI scripts. `xcrun xctrace list devices` lists UDIDs.
# IOS_UDID=
IOS_PLATFORM_VERSION=16.7
# Required for WDA build/signing on a physical device.
XCODE_ORG_ID=replace-me
XCODE_SIGNING_ID=Apple Development
WDA_BUNDLE_ID=com.example.WebDriverAgentRunner
